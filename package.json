{
  "name": "@youproof.org/editor",
  "publisher": "youproof.org",
  "displayName": "YouProof Editor",
  "description": "Sidebar explorer for YouProof mathematical content YAML files",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/youproof-org/editor.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=24.18.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "youproof-explorer",
          "title": "YouProof Editor",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "youproof-explorer": [
        {
          "type": "webview",
          "id": "youproofSidebar",
          "name": "Content Explorer",
          "icon": "media/icon.png"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "youproof.nodeEditor",
        "displayName": "YouProof Node Editor",
        "selector": [{ "filenamePattern": "*.youproof-node" }],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "YouProof Editor",
      "properties": {
        "youproof.contentRoot": {
          "type": "string",
          "description": "Path to the YouProof content directory. Absolute, or relative to the workspace root."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./ && esbuild media/src/sidebar/index.tsx --bundle --outfile=media/panel.js --platform=browser --format=iife --jsx=automatic --sourcemap && esbuild media/src/editor/index.tsx --bundle --outfile=media/editor.js --platform=browser --format=iife --jsx=automatic --sourcemap",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
